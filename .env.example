# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=OwlyMarket

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Valyu AI (Optional - for proprietary data access)
VALYU_API_KEY=valyu_your-api-key-here

# Base Network (x402 Payment)
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_TESTNET_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_BASE_USDC_TESTNET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_PAYMENT_WALLET=0x0000000000000000000000000000000000000000

# x402 Payment Configuration
NEXT_PUBLIC_X402_PAYMENT_AMOUNT=10.00
NEXT_PUBLIC_X402_CURRENCY=USDC
NEXT_PUBLIC_X402_NETWORK=base
NEXT_PUBLIC_X402_CHAIN_ID=8453
NEXT_PUBLIC_X402_TESTNET_CHAIN_ID=84532

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Privy Authentication
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret

# App Features
NEXT_PUBLIC_FREE_TIER_LIMIT=2
NEXT_PUBLIC_PREMIUM_PRICE_USDT=10

# Feature Flags
NEXT_PUBLIC_ENABLE_VALYU=false
NEXT_PUBLIC_ENABLE_KALSHI=false
NEXT_PUBLIC_ENABLE_REAL_PAYMENTS=true

# Environment
NODE_ENV=development
